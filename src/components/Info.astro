---
import { restaurant } from '../data/restaurant';

const details = [
  {
    title: 'Services',
    lines: [...restaurant.services],
  },
  {
    title: 'Location',
    lines: [restaurant.street, restaurant.city, 'United States'],
  },
  {
    title: 'Contact',
    lines: [restaurant.phone, restaurant.instagram],
  },
];
---

<section id="info" class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
  <div class="flex flex-col justify-center gap-8">
    <header class="flex flex-col gap-3">
      <p class="text-sm text-cactus-400">Visit us</p>
      <h2 class="section-title text-4xl text-sand-100 sm:text-5xl">{restaurant.name}</h2>
      <p class="text-base text-cactus-300">{restaurant.slogan}</p>
    </header>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        details.map((block) => (
          <div class="border-t border-night-600 pt-4">
            <h3 class="mb-2 text-base font-semibold text-cactus-400">{block.title}</h3>
            <ul class="space-y-1 text-sm text-sand-200/75">
              {block.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="rounded-sm border border-dashed border-night-600 bg-night-900/60 px-4 py-3">
      <ul class="space-y-1 text-xs leading-relaxed text-mustard-400/90">
        {
          restaurant.notasGenerales.map((nota) => (
            <li>*{nota}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
