---
import { Image, getImage } from 'astro:assets';
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;

const lightboxImage = item.image
  ? await getImage({ src: item.image, width: 1400, format: 'webp' })
  : undefined;
---

<article
  class="group flex min-w-0 flex-col gap-3"
>
  {
    item.image && (
      <button
        type="button"
        class="relative w-full cursor-zoom-in overflow-hidden rounded-lg bg-night-800"
        style="aspect-ratio: 16 / 10;"
        data-lightbox-src={lightboxImage?.src}
        data-lightbox-alt={item.name}
        aria-label={`View ${item.name} full size`}
      >
        <Image
          src={item.image}
          alt={item.name}
          width={800}
          height={500}
          format="webp"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 [@media(hover:hover)]:group-hover:scale-102"
        />
      </button>
    )
  }

  <div class="flex items-baseline gap-3">
    <h3 class="min-w-0 flex-1 text-lg font-semibold leading-snug text-sand-100">{item.name}</h3>
    {item.price && <span class="menu-price shrink-0 text-lg font-bold text-cactus-400">{item.price}</span>}
  </div>

  {item.description && <p class="text-sm leading-relaxed text-sand-200">{item.description}</p>}

  {
    item.opciones && (
      <ul class="flex flex-wrap gap-2">
        {item.opciones.map((opcion) => (
          <li class="rounded-sm border border-night-600 bg-night-900/60 px-2.5 py-1 text-xs text-sand-200/80">{opcion}</li>
        ))}
      </ul>
    )
  }

  {
    item.extras && (
      <p class="text-sm font-medium text-cactus-400">
        {item.extras}
      </p>
    )
  }

  {
    item.tag && (
      <span
        class="menu-tag w-fit"
      >
        {item.tag}
      </span>
    )
  }
</article>
