---
import MenuItem from './MenuItem.astro';
import MenuItemRow from './MenuItemRow.astro';
import { Image } from 'astro:assets';
import type { MenuSection } from '../data/menu';

interface Props {
  section: MenuSection;
  banner?: import('astro').ImageMetadata;
}

const { section, banner } = Astro.props;

const itemsWithImage = section.items.filter((item) => item.image);
const itemsWithoutImage = section.items.filter((item) => !item.image);
---

<section id={section.id} class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
  {banner && (
    <div class="w-full max-w-[500px] mx-auto mb-10">
      <Image
        src={banner}
        alt="Taco Tuesday"
        width={1086}
        height={1448}
        format="webp"
        loading="eager"
        class="w-full h-auto object-contain block mx-auto"
      />
    </div>
  )}

  <header class="menu-section-heading mb-8 flex flex-col items-start gap-3 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="menu-heading text-3xl text-sand-100 sm:text-4xl">{section.title}</h2>
    <p class="text-sm text-sand-300">{section.subtitle}</p>
  </header>

  {
    itemsWithImage.length > 0 && (
      <div class="mb-10 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
        {itemsWithImage.map((item) => <MenuItem item={item} />)}
      </div>
    )
  }
  {
    itemsWithoutImage.length > 0 && (
      <div class="grid grid-cols-1 gap-x-10 sm:grid-cols-2">
        {itemsWithoutImage.map((item) => <MenuItemRow item={item} />)}
      </div>
    )
  }
</section>
