---
import { Image } from 'astro:assets';
import { bowls } from '../data/menu';

const section = bowls;
---

<section id={section.id} class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
  <header class="menu-section-heading mb-8 flex flex-col items-start gap-3">
    <p class="text-sm text-sand-300">{section.subtitle}</p>
    <div class="flex w-full flex-col items-start gap-3 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="menu-heading text-3xl text-sand-100 sm:text-4xl">{section.title}</h2>
      <span
        class="menu-price text-lg font-bold text-cactus-400"
      >
        Base price {section.basePrice}
      </span>
    </div>
  </header>

  {
    section.image && (
      <div class="mb-10 flex justify-center">
        <button
          type="button"
          class="cursor-zoom-in overflow-hidden rounded-lg bg-night-800"
          style="width: 170px;"
          data-lightbox-src={section.image.src}
          data-lightbox-alt={section.title}
          aria-label={`View ${section.title} photo full size`}
        >
          <Image
            src={section.image}
            alt={section.title}
            width={222}
            height={264}
            format="webp"
            loading="lazy"
            class="h-auto w-full object-contain"
          />
        </button>
      </div>
    )
  }

  <div class="grid grid-cols-1 gap-x-10 sm:grid-cols-2">
    {
      section.options.map((option) => (
        <article class="flex min-w-0 flex-col gap-2 border-b border-night-700 py-5">
          <div class="flex items-baseline gap-3">
            <h3 class="min-w-0 flex-1 text-base font-semibold text-sand-100">{option.name}</h3>
            {option.extraPrice && (
              <span class="menu-price shrink-0 text-sm font-bold text-cactus-400">
                {option.extraPrice}
              </span>
            )}
          </div>
          <p class="text-sm leading-relaxed text-sand-200">{option.description}</p>
        </article>
      ))
    }
  </div>
</section>
