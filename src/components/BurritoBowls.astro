---
import { Image } from 'astro:assets';
import { bowls } from '../data/menu';

const section = bowls;
---

<section id={section.id} class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
  <header class="mb-10 flex flex-col items-center gap-3 text-center">
    <div class="flex items-center gap-4 text-mustard-500">
      <span class="h-px w-10 bg-mustard-600/70"></span>
      <span class="text-xs font-semibold uppercase tracking-[0.4em]">{section.subtitle}</span>
      <span class="h-px w-10 bg-mustard-600/70"></span>
    </div>

    <div class="flex flex-col items-center gap-3 sm:flex-row sm:gap-5">
      <h2 class="section-title text-4xl text-sand-100 sm:text-5xl">{section.title}</h2>
      <span
        class="rounded-sm border border-mustard-500/60 bg-mustard-500/10 px-4 py-1.5 text-lg font-bold text-cactus-400"
      >
        Base price {section.basePrice}
      </span>
    </div>
  </header>

  {
    section.image && (
      <div class="mb-10 flex justify-center">
        <div
          class="cursor-zoom-in overflow-hidden rounded-sm border border-night-700 transition-colors hover:border-mustard-500/60"
          style="width: 170px;"
          data-lightbox-src={section.image.src}
          data-lightbox-alt={section.title}
          role="button"
          tabindex="0"
          aria-label={`View ${section.title} photo full size`}
        >
          <Image
            src={section.image}
            alt={section.title}
            width={222}
            height={264}
            format="webp"
            loading="lazy"
            class="h-auto w-full object-contain"
          />
        </div>
      </div>
    )
  }

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {
      section.options.map((option) => (
        <article class="group flex flex-col gap-3 rounded-sm border border-night-700 bg-night-800/60 p-5 transition-colors duration-300 hover:border-mustard-500/50">
          <div class="flex items-baseline gap-3">
            <h3 class="flex-1 text-base font-semibold text-sand-100">{option.name}</h3>
            {option.extraPrice && (
              <span class="shrink-0 rounded-full border border-cactus-600/60 bg-cactus-800/40 px-2.5 py-0.5 text-sm font-bold text-cactus-400">
                {option.extraPrice}
              </span>
            )}
          </div>
          <div class="h-px w-full bg-night-600" />
          <p class="text-sm leading-relaxed text-sand-200">{option.description}</p>
        </article>
      ))
    }
  </div>
</section>
