---
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<article
  class="flex min-w-0 flex-col gap-2 border-b border-night-700 py-5"
>
  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <div class="flex items-baseline gap-3">
      <h3 class="min-w-0 flex-1 text-base font-semibold leading-snug text-sand-100">{item.name}</h3>
      {item.price && <span class="menu-price shrink-0 text-lg font-bold text-cactus-400">{item.price}</span>}
    </div>

    {item.description && <p class="text-sm leading-relaxed text-sand-200">{item.description}</p>}

    {
      item.opciones && (
        <ul class="flex flex-wrap gap-2">
          {item.opciones.map((opcion) => (
            <li class="rounded-sm border border-night-600 bg-night-900/60 px-2.5 py-1 text-xs text-sand-200/80">{opcion}</li>
          ))}
        </ul>
      )
    }

    {
      item.extras && (
        <p class="text-sm font-medium text-cactus-400">
          {item.extras}
        </p>
      )
    }
  </div>

  {
    item.tag && (
      <span
        class="menu-tag w-fit"
      >
        {item.tag}
      </span>
    )
  }
</article>
