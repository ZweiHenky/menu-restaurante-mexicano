---
interface Props {
  label?: string;
  ratio?: string;
  class?: string;
}

const { label = 'Image placeholder', ratio = '4 / 3', class: className = '' } = Astro.props;
---

<div
  class={`relative flex w-full items-center justify-center overflow-hidden rounded-sm border border-dashed border-night-600 bg-night-800 ${className}`}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={label}
>
  <div
    class="absolute inset-0 opacity-[0.35]"
    style="background-image: repeating-linear-gradient(135deg, #e1cfb3 0 14px, #efe3c9 14px 28px);"
  >
  </div>
  <div class="absolute inset-3 rounded-sm border border-night-600/70"></div>

  <div class="relative z-10 flex flex-col items-center gap-2 px-4 text-center">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="size-8 text-cactus-500"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round"
        d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 19.5h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
    </svg>
    <span class="text-[0.65rem] font-medium uppercase tracking-[0.25em] text-sand-400/70">{label}</span>
  </div>
</div>
