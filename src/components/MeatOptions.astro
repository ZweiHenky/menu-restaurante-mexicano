---
import { meatOptions } from '../data/restaurant';
---

<section
  id="meat-options"
  class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8"
  aria-label="Meat options"
>
  <div
    class="rounded-lg bg-cactus-800/60 p-6 sm:p-8"
  >
    <header class="mb-6 flex flex-col items-start gap-2">
      <span class="text-sm text-cactus-300">
        Choose your meat
      </span>
      <h2 class="menu-heading text-2xl text-sand-100 sm:text-3xl">Meat Options</h2>
    </header>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div>
        <h3 class="mb-3 border-b border-cactus-600/20 pb-2 text-sm font-semibold text-cactus-400">
          General
        </h3>
        <ul class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-2">
          {
            meatOptions.general.map((meat) => (
              <li class="flex items-baseline justify-between gap-2 border-b border-night-700/70 py-1.5 text-sm">
                <span class="font-medium text-sand-100">{meat.label}</span>
                <span class="text-right text-xs text-sand-200/70">{meat.value}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-3 border-b border-cactus-600/20 pb-2 text-sm font-semibold text-cactus-400">
          For Burritos Básico &amp; Supremo
        </h3>
        <ul class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-2">
          {
            meatOptions.burritos.map((meat) => (
              <li class="flex items-baseline justify-between gap-2 border-b border-night-700/70 py-1.5 text-sm">
                <span class="font-medium text-sand-100">{meat.label}</span>
                <span
                  class={
                    meat.value === '+$3'
                      ? 'text-xs font-semibold text-terra-500'
                      : 'text-xs text-sand-200/70'
                  }
                >
                  {meat.value}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
