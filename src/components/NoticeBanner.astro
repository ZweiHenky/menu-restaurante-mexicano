---
import { restaurant } from '../data/restaurant';
---

<div class="border-y border-mustard-500/40 bg-night-800">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-5 py-4 text-center sm:px-8">
    <span
      class="rounded-sm bg-mustard-500 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-sand-50"
    >
      {restaurant.notice}
    </span>
    <span class="text-[0.7rem] uppercase tracking-[0.25em] text-cactus-300/80">
      {restaurant.services[1]}
    </span>
  </div>
</div>
